# Cloudflare Pages response headers.

# Hashed build assets and fonts never change under the same URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Pagefind writes content-hashed index fragments under here, same as _astro.
# pagefind.js itself keeps the same URL across builds, so it is not immutable.
/pagefind/*.pf_*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Everything is first-party: the inline scripts are the theme toggle, the
  # JSON-LD blocks and the blog search, and the only styles are Tailwind's
  # bundle. 'wasm-unsafe-eval' is there for Pagefind, whose index reader is
  # WebAssembly — without it the search box never appears and nothing else on
  # the page notices.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
