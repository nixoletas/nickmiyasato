---
import type { InferGetStaticPropsType } from "astro";
import PostDetail from "@/components/PostDetail.astro";
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
import { entrySlug, getPosts } from "@/lib/content";
import { breadcrumbSchema, postOgImage, postSchema } from "@/lib/seo";

export async function getStaticPaths() {
  const posts = await getPosts("pt-br");
  return posts.map((post) => ({
    params: { slug: entrySlug(post.id) },
    props: { post },
  }));
}

type Props = InferGetStaticPropsType<typeof getStaticPaths>;

const { post } = Astro.props as Props;

const ogImage = await postOgImage(post, "pt-br");
const schemas = [
  postSchema(post, "pt-br", ogImage),
  breadcrumbSchema("pt-br", [
    { name: site.name, path: "/" },
    { name: "Blog", path: "/blog" },
    { name: post.data.title, path: `/blog/${entrySlug(post.id)}` },
  ]),
];
---

<Base
  title={`${post.data.title} — ${site.name}`}
  description={post.data.summary}
  image={ogImage}
  ogType="article"
  published={post.data.date.toISOString()}
  modified={post.data.updated?.toISOString()}
  noindex={post.data.draft}
  schemas={schemas}
>
  <PostDetail post={post} />
</Base>
