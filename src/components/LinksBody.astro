---
import { Image } from "astro:assets";
import portrait from "@/assets/nick.jpeg";
import Icon from "@/components/Icon.astro";
import { site } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const email = site.email[lang];

/** Android deep link: opens the app, or `url` when it is not installed. */
const intent = (url: string, pkg: string) => {
  const { host, pathname } = new URL(url);
  const fallback = encodeURIComponent(url);
  return `intent://${host}${pathname}#Intent;scheme=https;package=${pkg};S.browser_fallback_url=${fallback};end`;
};

const links = [
  {
    // First on purpose: someone tapping through from a bio who might hire me
    // should not have to scroll past the social profiles to find out how.
    href: localizePath("/services", lang),
    label: t("nav.services"),
    value: lang === "en" ? "Websites, apps and data" : "Sites, sistemas e dados",
    icon: "briefcase" as const,
  },
  {
    href: site.youtube,
    label: "YouTube",
    value: "@nixoletas",
    icon: "youtube" as const,
    android: intent(site.youtube, "com.google.android.youtube"),
    ios: "youtube://www.youtube.com/@nixoletas",
  },
  {
    href: site.instagram,
    label: "Instagram",
    value: "@nickmiyasato",
    icon: "instagram" as const,
    android: intent(site.instagram, "com.instagram.android"),
    ios: "instagram://user?username=nickmiyasato",
  },
  {
    href: site.linkedin,
    label: "LinkedIn",
    value: "in/nixoletas",
    icon: "linkedin" as const,
    android: intent(site.linkedin, "com.linkedin.android"),
    ios: "linkedin://in/nixoletas",
  },
  {
    href: site.github,
    label: "GitHub",
    value: "@nixoletas",
    icon: "github" as const,
  },
  {
    href: `mailto:${email}`,
    label: t("contact.email"),
    value: email,
    icon: "mail" as const,
  },
];
---

<section class="shell py-14 sm:py-20">
  <div class="rise mx-auto flex max-w-md flex-col items-center gap-8">
    <header class="flex flex-col items-center gap-4 text-center">
      <Image
        src={portrait}
        alt={site.legalName}
        width={112}
        height={112}
        densities={[1, 2]}
        loading="eager"
        class="size-28 rounded-full border border-border object-cover"
      />
      <h1 class="text-2xl font-semibold">
        {site.legalName}
        <span class="mt-2 block text-base font-normal tracking-normal text-muted">
          {t("hero.role")}
        </span>
      </h1>
    </header>

    <ul class="flex w-full flex-col gap-3">
      {
        links.map((link) => (
          <li>
            <a
              href={link.href}
              data-android={link.android}
              data-ios={link.ios}
              {...link.href.startsWith("http")
                ? { target: "_blank", rel: "me noopener" }
                : {}}
              class="card group flex items-center gap-4 px-5 py-4"
            >
              <span class="shrink-0 text-muted transition-colors group-hover:text-accent">
                <Icon name={link.icon} size={20} />
              </span>
              <span class="flex min-w-0 flex-1 flex-col">
                <span class="font-medium">{link.label}</span>
                <span class="truncate font-mono text-xs text-muted">{link.value}</span>
              </span>
              <span class="shrink-0 text-muted transition-colors group-hover:text-accent">
                <Icon name="arrow-up-right" size={16} />
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<script is:inline>
  // This page lives in a social bio, so most taps come from the Instagram or
  // TikTok in-app browser, which ignores Universal Links and App Links and
  // would open the profile inside itself. The href stays a plain https URL, so
  // desktop and no-JS visitors are unaffected.
  (() => {
    const ua = navigator.userAgent;
    const android = /Android/i.test(ua);
    const ios = /iPhone|iPad|iPod/i.test(ua);
    const inApp = /Instagram|FBAN|FBAV|FB_IAB|Threads|TikTok|musical_ly|BytedanceWebview|LinkedInApp|Twitter/i.test(ua);

    // A normal iOS browser already honours Universal Links, and a custom scheme
    // there would show an error when the app is missing.
    if (!android && !(ios && inApp)) return;

    document.querySelectorAll("a[data-android]").forEach((link) => {
      link.addEventListener("click", (event) => {
        event.preventDefault();

        if (android) {
          // Same tab: target=_blank would strand an empty tab behind the app.
          // The intent carries its own fallback URL.
          location.href = link.dataset.android;
          return;
        }

        // iOS cannot tell us whether a scheme opened anything, so if the page
        // is still visible shortly after, assume the app is not installed.
        const timer = setTimeout(() => {
          if (!document.hidden) location.href = link.href;
        }, 1500);
        const cancel = () => clearTimeout(timer);
        document.addEventListener("visibilitychange", cancel, { once: true });
        window.addEventListener("pagehide", cancel, { once: true });

        location.href = link.dataset.ios;
      });
    });
  })();
</script>
