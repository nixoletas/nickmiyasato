# Cloudflare Pages response headers.

# Hashed build assets and fonts never change under the same URL.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # The site ships no third-party code and no inline styles beyond Tailwind's
  # bundle; the two inline scripts are the theme toggle and the JSON-LD block.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; form-action 'none'; frame-ancestors 'none'; base-uri 'self'
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
