---
import ProjectsIndexBody from "@/components/ProjectsIndexBody.astro";
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
import { breadcrumbSchema } from "@/lib/seo";

const breadcrumb = breadcrumbSchema("en", [
  { name: site.name, path: "/" },
  { name: "Projects", path: "/projects" },
]);
---

<Base
  title={`Projects — ${site.name}`}
  description="The projects I've designed and shipped: client platforms running in production, an expense app on Android and web, and the technical decisions behind each one."
  schemas={[breadcrumb]}
>
  <ProjectsIndexBody />
</Base>
