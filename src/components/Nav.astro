---
import Icon from "@/components/Icon.astro";
import { langShort, type Lang } from "@/i18n/ui";
import {
  alternateUrls,
  getLangFromUrl,
  localizePath,
  useTranslations,
} from "@/i18n/utils";

interface Props {
  /** Passed down by Base, which knows about routes whose path is translated. */
  alternates?: Record<Lang, string>;
}

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const alternates = Astro.props.alternates ?? alternateUrls(Astro.url);

const other: Lang = lang === "en" ? "pt-br" : "en";

// Section anchors resolve against the home page so they also work from a
// project detail page.
const home = localizePath("/", lang);
const links = [
  { href: `${home === "/" ? "" : home}/#work`, label: t("nav.work") },
  { href: localizePath("/projects", lang), label: t("nav.projects") },
  { href: `${home === "/" ? "" : home}/#about`, label: t("nav.about") },
  { href: localizePath("/blog", lang), label: t("nav.blog") },
  { href: localizePath("/resume", lang), label: t("nav.resume") },
  { href: `${home === "/" ? "" : home}/#contact`, label: t("nav.contact") },
];
---

<header
  data-pagefind-ignore
  class="sticky top-0 z-40 border-b border-border/70 bg-bg/80 backdrop-blur-md"
>
  <nav
    class="shell flex h-16 items-center justify-between gap-4"
    aria-label="Main"
  >
    <a
      href={home}
      class="font-mono text-sm font-medium tracking-tight transition-colors hover:text-accent"
    >
      nick<span class="text-accent">.</span>miyasato
    </a>

    <div class="flex items-center gap-1 sm:gap-2">
      {/* Six links do not fit a phone. Below `sm` they move into the panel
          below, which is why none of them carries a narrow-screen variant. */}
      <ul class="hidden items-center gap-1 sm:flex sm:gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded-md px-2 py-1.5 text-sm text-muted transition-colors hover:text-fg sm:px-3"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>

      <span class="mx-1 h-4 w-px bg-border" aria-hidden="true"></span>

      <a
        href={alternates[other]}
        hreflang={other === "en" ? "en" : "pt-BR"}
        title={t("nav.lang")}
        class="rounded-md px-2 py-1.5 font-mono text-xs text-muted transition-colors hover:text-fg"
      >
        {langShort[other]}
      </a>

      <button
        type="button"
        id="theme-toggle"
        aria-label={t("nav.theme")}
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-fg"
      >
        <Icon name="sun" size={17} class="hidden dark:block" />
        <Icon name="moon" size={17} class="block dark:hidden" />
      </button>

      <button
        type="button"
        id="menu-toggle"
        aria-label={t("nav.menu")}
        aria-expanded="false"
        aria-controls="menu-panel"
        class="grid size-9 place-items-center rounded-md text-muted transition-colors hover:text-fg sm:hidden"
      >
        {/* Swapped by the script rather than by a CSS variant: the icons are
            components, so a class on them lands inside Icon.astro's own scope
            and a parent [aria-expanded] selector would not reach it. */}
        <span id="menu-icon-open"><Icon name="menu" size={18} /></span>
        <span id="menu-icon-close" hidden><Icon name="close" size={18} /></span>
      </button>
    </div>
  </nav>

  {/* Inside <header> so it inherits the sticky position and the blur, and so
      the border under the bar reads as the panel's own edge when open. */}
  <nav
    id="menu-panel"
    aria-label={t("nav.menu")}
    hidden
    class="border-t border-border sm:hidden"
  >
    <ul class="shell flex flex-col py-2">
      {
        links.map((link) => (
          <li class="border-b border-border/60 last:border-b-0">
            <a
              href={link.href}
              class="block py-3.5 text-sm text-muted transition-colors hover:text-fg"
            >
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>

<script is:inline>
  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    try {
      localStorage.setItem("theme", dark ? "dark" : "light");
    } catch {}
  });
</script>

<script
  is:inline
  define:vars={{ openLabel: t("nav.menu"), closeLabel: t("nav.close") }}
>
  (() => {
    const toggle = document.getElementById("menu-toggle");
    const panel = document.getElementById("menu-panel");
    const iconOpen = document.getElementById("menu-icon-open");
    const iconClose = document.getElementById("menu-icon-close");
    if (!toggle || !panel || !iconOpen || !iconClose) return;

    const set = (open) => {
      panel.hidden = !open;
      iconOpen.hidden = open;
      iconClose.hidden = !open;
      toggle.setAttribute("aria-expanded", String(open));
      toggle.setAttribute("aria-label", open ? closeLabel : openLabel);
    };

    toggle.addEventListener("click", () => set(panel.hidden));

    // A same-page anchor does not reload anything, so the panel would sit open
    // over the section it just jumped to.
    panel.addEventListener("click", (event) => {
      if (event.target.closest("a")) set(false);
    });

    document.addEventListener("keydown", (event) => {
      if (event.key !== "Escape" || panel.hidden) return;
      set(false);
      toggle.focus();
    });

    // Rotating to landscape past the breakpoint hides the panel's container
    // while it is still open, which would leave the button claiming expanded
    // and the panel reappearing on the way back.
    matchMedia("(min-width: 40rem)").addEventListener("change", (event) => {
      if (event.matches) set(false);
    });
  })();
</script>
