---
import Icon from "@/components/Icon.astro";

export interface TocItem {
  /** id of the element on the page this jumps to. */
  id: string;
  label: string;
  /** Optional right-aligned figure — a post count, say. */
  badge?: string | number;
}

interface Props {
  items: TocItem[];
  /**
   * "rail" is the sticky column beside the content on large screens; "inline"
   * is the collapsed disclosure above it on everything narrower. A page can
   * render both and hide one per breakpoint, so only one is ever in the
   * accessibility tree.
   */
  variant: "rail" | "inline";
  title: string;
  /**
   * Selector for the elements the highlight tracks, in document order. Only
   * read by the rail, which is the only variant that highlights.
   */
  spy: string;
}

const { items, variant, title, spy } = Astro.props;
const titleId = `toc-${variant}-title`;
---

{
  variant === "rail" ? (
    <nav
      id="toc-rail"
      aria-labelledby={titleId}
      data-pagefind-ignore
      class="hidden lg:col-start-2 lg:row-start-1 lg:block"
    >
      {/* top-24 clears the 4rem sticky header with the same breathing room as
          the scroll-padding-top in global.css, so a target jumped to from here
          lands where the highlight says it is. */}
      <div class="sticky top-24 max-h-[calc(100vh-8rem)] overflow-y-auto">
        <h2 id={titleId} class="eyebrow">
          {title}
        </h2>

        <ol class="mt-4 flex flex-col border-l border-border">
          {items.map((item) => (
            <li>
              <a
                href={`#${item.id}`}
                class="-ml-px flex items-center justify-between gap-3 border-l border-transparent py-1.5 pr-1 pl-4 text-sm text-muted transition-colors hover:text-fg aria-[current=location]:border-accent aria-[current=location]:text-accent"
              >
                {item.label}
                {item.badge !== undefined && (
                  <span class="font-mono text-xs opacity-60">{item.badge}</span>
                )}
              </a>
            </li>
          ))}
        </ol>
      </div>
    </nav>
  ) : (
    <details
      class="group rounded-xl border border-border bg-surface lg:hidden"
      data-pagefind-ignore
    >
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-5 py-4 [&::-webkit-details-marker]:hidden">
        <span class="eyebrow">{title}</span>
        <span class="flex items-center gap-2 font-mono text-xs text-muted">
          {items.length}
          <Icon
            name="chevron-down"
            size={14}
            class="transition-transform group-open:rotate-180"
          />
        </span>
      </summary>

      <ol class="flex flex-col gap-3 border-t border-border px-5 py-4">
        {items.map((item) => (
          <li>
            <a
              href={`#${item.id}`}
              class="flex items-center justify-between gap-3 text-sm text-muted transition-colors hover:text-accent"
            >
              {item.label}
              {item.badge !== undefined && (
                <span class="font-mono text-xs opacity-60">{item.badge}</span>
              )}
            </a>
          </li>
        ))}
      </ol>
    </details>
  )
}

{
  /* Only the rail highlights, and a page has at most one, so the script ships
     with that variant rather than twice from the component as a whole. */
  variant === "rail" && (
    <script is:inline define:vars={{ spy }}>
      (() => {
        const start = () => {
          const rail = document.getElementById("toc-rail");
          const targets = [...document.querySelectorAll(spy)];
          if (!rail || targets.length === 0) return;

          const links = new Map(
            [...rail.querySelectorAll("a[href^='#']")].map((a) => [
              decodeURIComponent(a.getAttribute("href").slice(1)),
              a,
            ]),
          );

          let current = null;
          const mark = (id) => {
            if (id === current) return;
            links.get(current)?.removeAttribute("aria-current");
            // "location" rather than "page": this is a position within the
            // document, not a link to the page you are already on.
            links.get(id)?.setAttribute("aria-current", "location");
            current = id;
          };

          // The line a target has to cross to count as the one being read.
          // Below the sticky header, so a heading level with the top of the
          // viewport is already active rather than about to be.
          const LINE = 120;

          const update = () => {
            const doc = document.documentElement;
            const scrolls = doc.scrollHeight > innerHeight + 1;
            // At the very bottom the last target can sit below the line and
            // never be reached — a short final section would leave the rail
            // pointing at the one before it while you read the end of the page.
            if (scrolls && innerHeight + Math.ceil(scrollY) >= doc.scrollHeight - 2) {
              mark(targets[targets.length - 1].id);
              return;
            }

            let active = targets[0].id;
            for (const target of targets) {
              if (target.getBoundingClientRect().top > LINE) break;
              active = target.id;
            }
            mark(active);
          };

          let queued = false;
          const schedule = () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              update();
            });
          };

          addEventListener("scroll", schedule, { passive: true });
          addEventListener("resize", schedule, { passive: true });
          // The blog index hides its list while a search is running, which
          // takes the rail's targets out of the layout with it.
          addEventListener("toc:refresh", update);
          update();
        };

        // The rail is placed before the content in the source so the outline
        // comes first for a screen reader, which means this script runs before
        // the elements it measures exist. Waiting is not optional.
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", start, { once: true });
        } else {
          start();
        }
      })();
    </script>
  )
}
