---
import Icon from "@/components/Icon.astro";
import { site } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const year = new Date().getFullYear();

const socials = [
  { href: site.github, label: "GitHub", icon: "github" as const },
  { href: site.linkedin, label: "LinkedIn", icon: "linkedin" as const },
  { href: `mailto:${site.email[lang]}`, label: "Email", icon: "mail" as const },
];
---

<footer
  data-pagefind-ignore
  class="mt-24 border-t border-border py-10 text-sm text-muted sm:mt-32"
>
  <div class="shell flex flex-col gap-6 sm:flex-row sm:items-center sm:justify-between">
    <div class="flex flex-col gap-1">
      <p>© {year} {site.legalName} · {site.location[lang]}</p>
      <p class="text-xs">{t("footer.built")}</p>
    </div>

    <ul class="flex items-center gap-4">
      {
        socials.map((s) => (
          <li>
            <a
              href={s.href}
              rel="me noopener"
              target={s.href.startsWith("mailto:") ? undefined : "_blank"}
              aria-label={s.label}
              class="grid size-9 place-items-center rounded-md border border-border transition-colors hover:border-accent hover:text-accent"
            >
              <Icon name={s.icon} size={16} />
            </a>
          </li>
        ))
      }
      <li>
        <a
          href={site.repo}
          target="_blank"
          rel="noopener"
          class="link-underline text-xs"
        >
          {t("footer.source")}
        </a>
      </li>
    </ul>
  </div>
</footer>
