---
import BlogIndexBody from "@/components/BlogIndexBody.astro";
import Base from "@/layouts/Base.astro";
import { site } from "@/data/site";
import { getPosts } from "@/lib/content";
import { blogSchema, breadcrumbSchema } from "@/lib/seo";

const posts = await getPosts("pt-br");
---

<Base
  title={`Blog — ${site.name}`}
  description="Notas sobre sistemas que construí e operei — infraestrutura, pipelines de dados e as partes que só aparecem quando a coisa está em produção."
  schemas={[
    blogSchema("pt-br", posts),
    breadcrumbSchema("pt-br", [
      { name: site.name, path: "/" },
      { name: "Blog", path: "/blog" },
    ]),
  ]}
>
  <BlogIndexBody />
</Base>
