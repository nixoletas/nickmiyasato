---
import { Image } from "astro:assets";
import portrait from "@/assets/nick.jpeg";
import Icon from "@/components/Icon.astro";
import { services } from "@/data/services";
import { intro, site } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const { headline, tagline, focus } = intro[lang];
const { cta } = services[lang];
const quote = `mailto:${site.email[lang]}?subject=${encodeURIComponent(cta.subject)}&body=${encodeURIComponent(cta.body)}`;
---

<section class="hero-glow shell pt-14 pb-6 sm:pt-24 sm:pb-10">
  <div class="grid items-center gap-10 md:grid-cols-[minmax(0,1fr)_auto] md:gap-16">
    <div class="flex max-w-2xl flex-col gap-7">
      {/* The greeting is an eyebrow, not the h1: the h1 carries name and role,
          the two things someone is actually scanning for. */}
      <div class="rise flex flex-col gap-4">
        <p class="flex flex-wrap items-center gap-x-3 gap-y-2 font-mono text-xs text-muted">
          <span class="inline-flex items-center gap-2 rounded-full border border-border bg-surface/70 px-3 py-1">
            <span class="relative flex size-2" aria-hidden="true">
              <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60 motion-reduce:hidden"></span>
              <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
            </span>
            {t("hero.available")}
          </span>
          <span>{site.location[lang]}</span>
        </p>
        <h1 class="text-4xl font-semibold tracking-tight">
          <span class="block text-lg font-normal tracking-normal text-muted">{headline}</span>
          {site.legalName}<span class="text-accent">.</span>
          <span class="mt-3 block text-xl font-normal tracking-normal text-muted">
            {t("hero.role")}
          </span>
        </h1>
      </div>

      <p class="rise prose-measure text-lg" style="--d: 90ms">{tagline}</p>

      <ul class="rise flex flex-wrap gap-2" style="--d: 160ms" aria-label="Core stack">
        {focus.map((item) => <li class="tag">{item}</li>)}
      </ul>

      <div class="rise mt-1 flex flex-wrap items-center gap-3" style="--d: 230ms">
        <a href={quote} class="btn btn-primary">
          <Icon name="mail" size={16} />
          {cta.button}
        </a>
        <a href={localizePath("/resume", lang)} class="btn btn-ghost">
          <Icon name="file" size={16} />
          {t("nav.resume")}
        </a>
        <a
          href={site.github}
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
          class="btn btn-ghost size-10 justify-center p-0 text-muted"
        >
          <Icon name="github" size={16} />
        </a>
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener"
          aria-label="LinkedIn"
          class="btn btn-ghost size-10 justify-center p-0 text-muted"
        >
          <Icon name="linkedin" size={16} />
        </a>
      </div>
    </div>

    <div class="rise order-first md:order-last" style="--d: 60ms">
      {/* No fetchpriority="high" — the LCP element is the h1, so the portrait
          must not compete with the preloaded Inter file. */}
      <div class="relative w-fit">
        <div
          class="absolute -inset-3 -z-10 rotate-3 rounded-[1.6rem] border border-accent/30 bg-accent/5"
          aria-hidden="true"
        ></div>
        <Image
          src={portrait}
          alt={site.legalName}
          width={280}
          height={280}
          densities={[1, 2]}
          loading="eager"
          class="size-32 rounded-2xl border border-border object-cover shadow-[var(--shadow-lg)] sm:size-40 md:size-64"
        />
      </div>
    </div>
  </div>
</section>
