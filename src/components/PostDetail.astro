---
import { Picture } from "astro:assets";
import { render } from "astro:content";
import Icon from "@/components/Icon.astro";
import Toc from "@/components/Toc.astro";
import { site } from "@/data/site";
import {
  adjacentPosts,
  entrySlug,
  formatPostDate,
  readingTime,
  resolvePostCover,
  tagSlug,
  type PostEntry,
} from "@/lib/content";
import type { Lang } from "@/i18n/ui";
import { getLangFromUrl, localizePath, useTranslations } from "@/i18n/utils";

interface Props {
  post: PostEntry;
}

const { post } = Astro.props;
const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const { title, summary, date, updated, tags, draft, cover } = post.data;
const image = resolvePostCover(cover);
const { Content, headings } = await render(post);

const minutes = readingTime(post);
const published = formatPostDate(date, lang);
const tagBase = localizePath("/blog/tags", lang);

// Only the section headings, and only once there are enough of them to be
// worth a jump list — two entries is a list of the two things you can already
// see. MDX generates the ids, so the anchors need no extra config.
const toc = headings.filter((heading) => heading.depth === 2);
const showToc = toc.length >= 3;

const { newer, older } = await adjacentPosts(lang, post.id);
---

{/* data-pagefind-body scopes the search index to posts, so the résumé and the
    project write-ups cannot turn up in a blog search. Everything on the page
    that is navigation rather than prose is marked ignore below. */}
<article class="shell py-14 sm:py-20" data-pagefind-body>
  <a
    href={localizePath("/blog", lang)}
    data-pagefind-ignore
    class="inline-flex items-center gap-1.5 text-sm text-muted transition-colors hover:text-accent"
  >
    <Icon name="arrow-left" size={14} />
    {t("blog.back")}
  </a>

  <header class="mt-8 flex max-w-3xl flex-col gap-6 sm:mt-12">
    <h1 class="text-3xl" data-pagefind-meta="title">{title}</h1>
    <p class="prose-measure text-lg text-muted">{summary}</p>

    <div
      class="flex flex-wrap items-center gap-x-3 gap-y-2 border-y border-border py-4 font-mono text-xs text-muted"
    >
      {/* Explicit value rather than the element's text: the search result row
          wants the date on its own, without the "Published" label. */}
      <time datetime={date.toISOString()} data-pagefind-meta={`date:${published}`}>
        {t("blog.published")} {published}
      </time>
      {
        updated && (
          <Fragment>
            <span aria-hidden="true">·</span>
            <time datetime={updated.toISOString()}>
              {t("blog.updated")} {formatPostDate(updated, lang)}
            </time>
          </Fragment>
        )
      }
      <span aria-hidden="true">·</span>
      <span>{minutes} {t("blog.readingTime")}</span>
      <span aria-hidden="true">·</span>
      <span>{site.legalName}</span>
      {draft && <span class="tag text-accent">{t("blog.draft")}</span>}
    </div>

    {
      tags.length > 0 && (
        <ul class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <li>
              <a
                href={`${tagBase}/${tagSlug(tag)}`}
                class="tag transition-colors hover:border-accent hover:text-accent"
              >
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )
    }
  </header>

  {
    image && (
      <Picture
        src={image}
        formats={["avif"]}
        fallbackFormat="webp"
        alt=""
        widths={[640, 1024, 1280]}
        sizes="(min-width: 1024px) 62rem, 92vw"
        loading="eager"
        fetchpriority="high"
        class="mt-10 w-full rounded-xl border border-border object-cover sm:mt-14"
      />
    )
  }

  {showToc && <Toc headings={toc} variant="inline" />}

  {/* The rail sits in the second column but comes first in the source, so a
      screen reader or a tab through the page meets the outline before the
      article rather than after it. */}
  <div
    class="mt-12 sm:mt-16 lg:grid lg:grid-cols-[minmax(0,68ch)_minmax(0,1fr)] lg:gap-12"
  >
    {showToc && <Toc headings={toc} variant="rail" />}

    <div class="content prose-measure lg:col-start-1 lg:row-start-1">
      <Content />
    </div>
  </div>

  {
    (newer || older) && (
      <nav
        aria-label={t("blog.title")}
        data-pagefind-ignore
        class="mt-16 grid gap-4 border-t border-border pt-8 sm:mt-20 sm:grid-cols-2"
      >
        {newer ? (
          <a
            href={localizePath(`/blog/${entrySlug(newer.id)}`, lang)}
            class="group flex flex-col gap-2 rounded-lg border border-border p-4 transition-colors hover:border-accent"
          >
            <span class="eyebrow inline-flex items-center gap-1.5">
              <Icon name="arrow-left" size={12} />
              {t("blog.newer")}
            </span>
            <span class="transition-colors group-hover:text-accent">
              {newer.data.title}
            </span>
          </a>
        ) : (
          /* Holds the column so a post with only an older neighbour keeps it
             on the right, where the direction reads correctly. */
          <div class="hidden sm:block" />
        )}

        {older && (
          <a
            href={localizePath(`/blog/${entrySlug(older.id)}`, lang)}
            class="group flex flex-col gap-2 rounded-lg border border-border p-4 transition-colors hover:border-accent sm:text-right"
          >
            <span class="eyebrow inline-flex items-center gap-1.5 sm:justify-end">
              {t("blog.older")}
              <Icon name="arrow-right" size={12} />
            </span>
            <span class="transition-colors group-hover:text-accent">
              {older.data.title}
            </span>
          </a>
        )}
      </nav>
    )
  }
</article>
