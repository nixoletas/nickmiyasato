---
import Contact from "@/components/Contact.astro";
import Education from "@/components/Education.astro";
import Hero from "@/components/Hero.astro";
import HomeServices from "@/components/HomeServices.astro";
import ProjectFeature from "@/components/ProjectFeature.astro";
import ProjectRow from "@/components/ProjectRow.astro";
import Section from "@/components/Section.astro";
import Timeline from "@/components/Timeline.astro";
import { intro } from "@/data/site";
import type { Lang } from "@/i18n/ui";
import { getFeaturedProjects, getOtherProjects } from "@/lib/content";
import { getLangFromUrl, useTranslations } from "@/i18n/utils";

const lang: Lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const featured = await getFeaturedProjects(lang);
const others = await getOtherProjects(lang);
---

<Hero />

<HomeServices />

<Section id="work" eyebrow={t("work.title")} divider>
  <div class="flex flex-col gap-20 sm:gap-28">
    {
      featured.map((project, i) => (
        <ProjectFeature
          project={project}
          index={i + 1}
          flip={i % 2 === 1}
          eager={i === 0}
        />
      ))
    }
  </div>

  {others.length > 0 && (
    <div class="mt-16 sm:mt-24">
      <h3 class="eyebrow mb-4">{t("work.more")}</h3>
      <ul class="flex flex-col border-t border-border">
        {others.map((project) => <ProjectRow project={project} />)}
      </ul>
    </div>
  )}
</Section>

<Section id="experience" eyebrow={t("exp.title")} divider>
  <Timeline />
</Section>

<Section id="about" eyebrow={t("about.title")} divider>
  <div class="grid gap-12 md:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] md:gap-16">
    <div class="prose-measure flex flex-col gap-4 text-lg">
      {intro[lang].bio.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <Education />
  </div>
</Section>

<Section id="contact" eyebrow={t("contact.title")} divider>
  <Contact />
</Section>
